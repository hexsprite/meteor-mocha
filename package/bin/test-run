#!/usr/bin/env node
/* eslint-disable max-lines */
/* eslint-disable no-console, max-len, complexity */

// Suppress experimental warnings (e.g., fs.glob) to keep output clean
process.removeAllListeners('warning')
/**
 * CLI client for test daemon
 *
 * Usage:
 *   ./scripts/test-run                    # Run all tests (auto-starts daemon)
 *   ./scripts/test-run Calendar           # Filter by pattern
 *   ./scripts/test-run -t Calendar -t sync # Multiple patterns (OR)
 *   ./scripts/test-run Calendar -i        # Exclude pattern
 *   ./scripts/test-run --json             # JSON output for LLM/scripting
 *   ./scripts/test-run --llm              # LLM-friendly summary output
 *   ./scripts/test-run Calendar --json    # Filtered tests with JSON output
 *   ./scripts/test-run daemon start       # Start daemon explicitly
 *   ./scripts/test-run daemon stop        # Stop daemon
 *   ./scripts/test-run daemon status      # Check daemon status
 *   ./scripts/test-run daemon logs        # Show daemon logs
 *   ./scripts/test-run daemon logs -t    # Stream daemon logs (tail -f)
 *   ./scripts/test-run Calendar -w       # Watch mode: re-run on file changes
 */

const http = require('http')
const { spawn, execSync } = require('child_process')
const crypto = require('crypto')
const fs = require('fs')
const path = require('path')

const port = process.env.TEST_PORT || 9100
const pidFile = path.join(process.cwd(), '.meteor', 'local', 'test-daemon.pid')
const logFile = path.join(process.cwd(), '.meteor', 'local', 'test-daemon.log')
const lockFile = path.join(process.cwd(), '.meteor', 'local', 'test-daemon.lock')
const cacheFile = path.join(process.cwd(), '.meteor', 'local', 'test-cache.json')
const CACHE_TTL_MS = 60000 // 1 minute
const HEALTH_CHECK_TIMEOUT_MS = 2000
const RESTART_WAIT_TIMEOUT_MS = 120000
const DEFAULT_HOT_RELOAD_FILE = path.join(
  process.cwd(),
  'imports',
  'startup',
  'tests',
  'server.ts',
)

// Colors
const colors = {
  green: '\x1b[32m',
  red: '\x1b[31m',
  yellow: '\x1b[33m',
  cyan: '\x1b[36m',
  dim: '\x1b[2m',
  reset: '\x1b[0m',
}

const errorLineSnippets = [
  'Error',
  'error:',
  'TypeError',
  'SyntaxError',
  'Cannot find module',
  'EADDRINUSE',
  "Can't listen on port",
  'Running two copies of Meteor',
  'FATAL ERROR',
  'heap out of memory',
]

function isDaemonErrorLine(line) {
  return errorLineSnippets.some(snippet => line.includes(snippet))
}

const mongoTimeoutSnippets = [
  'server monitor timeout',
  'PoolClearedOnNetworkError',
  'MongoServerSelectionError',
  'MongoNetworkError',
  'Connection to 127.0.0.1:9101',
]

function isMongoTimeoutMessage(message) {
  if (!message) return false
  return mongoTimeoutSnippets.some(snippet => message.includes(snippet))
}

function getHotReloadFilePath() {
  return process.env.TEST_DAEMON_RELOAD_FILE || DEFAULT_HOT_RELOAD_FILE
}

function touchHotReloadFile(filePath = getHotReloadFilePath()) {
  const resolvedPath = path.resolve(filePath)
  try {
    const now = new Date()
    fs.utimesSync(resolvedPath, now, now)
    return { touched: true, path: resolvedPath }
  } catch (error) {
    return {
      touched: false,
      path: resolvedPath,
      error: error?.message || String(error),
    }
  }
}

function hasMongoTimeoutEvidence(crashDiagnostics, recentLogs = [], extraMessages = []) {
  const candidates = []

  if (crashDiagnostics?.error) {
    candidates.push(crashDiagnostics.error)
  }
  if (Array.isArray(crashDiagnostics?.stack) && crashDiagnostics.stack.length > 0) {
    candidates.push(crashDiagnostics.stack.join('\n'))
  }
  if (Array.isArray(recentLogs)) {
    candidates.push(...recentLogs)
  }
  if (Array.isArray(extraMessages)) {
    candidates.push(...extraMessages)
  }

  return candidates.some(isMongoTimeoutMessage)
}

/**
 * Get recent lines from the daemon log file
 * @param {number} numLines - Number of lines to return (default 20)
 * @returns {string[]} Array of recent log lines, or empty array if no log file
 */
function getRecentLogs(numLines = 20) {
  try {
    if (!fs.existsSync(logFile)) return []
    const content = fs.readFileSync(logFile, 'utf8')
    const lines = content.split('\n').filter(l => l.trim())
    return lines.slice(-numLines)
  } catch {
    return []
  }
}

function isHtmlErrorResponse(data) {
  const trimmed = data.trimStart()
  return trimmed.startsWith('<!DOCTYPE') ||
    trimmed.startsWith('<html') ||
    trimmed.includes('<title>Meteor App - Error</title>')
}

function parseDaemonHealthResponse(data) {
  if (isHtmlErrorResponse(data)) {
    return { status: 'down' }
  }

  try {
    const health = JSON.parse(data)
    const suites = typeof health.suites === 'number' ? health.suites : undefined
    if (health.status === 'shutting_down' || health.status === 'restarting') {
      return { status: 'restarting', suites }
    }
    if (typeof health.suites === 'number' || health.status === 'ok' || health.status === 'ready') {
      return { status: 'ready', suites }
    }
  } catch {
    // Not valid JSON - probably error page
  }

  return { status: 'down' }
}

// Check if daemon is running and healthy
// When Meteor crashes, it serves an error HTML page on ALL routes (including /test/health)
// So we need to verify the response is actually JSON, not the error page
function getDaemonStatus() {
  return new Promise((resolve) => {
    const req = http.get(`http://localhost:${port}/test/health`, (res) => {
      if (res.statusCode !== 200) {
        resolve({ status: 'down' })
        return
      }

      // Read the response body to verify it's JSON (not the error HTML page)
      let data = ''
      res.on('data', chunk => data += chunk)
      res.on('end', () => {
        resolve(parseDaemonHealthResponse(data))
      })
    })
    req.on('error', () => resolve({ status: 'down' }))
    req.setTimeout(HEALTH_CHECK_TIMEOUT_MS, () => {
      req.destroy()
      resolve({ status: 'down' })
    })
  })
}

async function isDaemonRunning() {
  const status = await getDaemonStatus()
  return status.status === 'ready'
}

/**
 * Get crash diagnostics from the server's HTML error page
 * When Meteor crashes, it serves an HTML page with the error at the root URL
 * Returns null if server is healthy or not responding at all
 */
function getServerCrashDiagnostics() {
  return new Promise((resolve) => {
    const req = http.get(`http://localhost:${port}/`, (res) => {
      let html = ''
      res.on('data', chunk => html += chunk)
      res.on('end', () => {
        // Check if this looks like a Meteor crash page
        if (!html.includes('Your app is crashing') && !html.includes('Error:') && !html.includes('error:')) {
          resolve(null) // Not a crash page
          return
        }

        // Extract error message from HTML
        // Meteor formats errors in <pre> tags or as plain text
        let errorMessage = null

        // Try to find error in <pre> tags
        const preMatch = html.match(/<pre[^>]*>([\s\S]*?)<\/pre>/i)
        if (preMatch) {
          errorMessage = preMatch[1]
            .replace(/<[^>]+>/g, '') // Strip HTML tags
            .replace(/&lt;/g, '<')
            .replace(/&gt;/g, '>')
            .replace(/&amp;/g, '&')
            .replace(/&quot;/g, '"')
            .trim()
        }

        // Try to find "Error:" pattern in body
        if (!errorMessage) {
          const errorMatch = html.match(/Error:\s*([^\n<]+)/i)
          if (errorMatch) {
            errorMessage = errorMatch[0].trim()
          }
        }

        // Try to find MODULE_NOT_FOUND or similar patterns
        if (!errorMessage) {
          const moduleMatch = html.match(/Cannot find module ['"]([^'"]+)['"]/i)
          if (moduleMatch) {
            errorMessage = `Cannot find module '${moduleMatch[1]}'`
          }
        }

        // Extract stack trace if present
        let stackTrace = null
        const stackMatch = html.match(/at\s+[\w.<>]+\s+\([^)]+\)[\s\S]*?(?=<\/|$)/i)
        if (stackMatch) {
          stackTrace = stackMatch[0]
            .replace(/<[^>]+>/g, '')
            .replace(/&lt;/g, '<')
            .replace(/&gt;/g, '>')
            .replace(/&amp;/g, '&')
            .split('\n')
            .slice(0, 10) // Limit stack trace lines
            .map(l => l.trim())
            .filter(l => l)
        }

        resolve({
          crashed: true,
          error: errorMessage || 'Server crashed (unable to parse error message)',
          stack: stackTrace,
          hint: 'Server crashed during startup. Check the error above and fix before running tests.',
        })
      })
    })
    req.on('error', () => resolve(null)) // Server not responding at all
    req.setTimeout(2000, () => {
      req.destroy()
      resolve(null)
    })
  })
}

// Read PID from file
function readPid() {
  try {
    return parseInt(fs.readFileSync(pidFile, 'utf8').trim(), 10)
  } catch {
    return null
  }
}

// Write PID to file
function writePid(pid) {
  const dir = path.dirname(pidFile)
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true })
  }
  fs.writeFileSync(pidFile, String(pid))
}

// Remove PID file
function removePid() {
  try {
    fs.unlinkSync(pidFile)
  } catch {
    // Ignore if doesn't exist
  }
}

// Check if process is running
function isProcessRunning(pid) {
  try {
    process.kill(pid, 0)
    return true
  } catch {
    return false
  }
}

function terminateProcess(pid) {
  if (!pid) return
  try {
    process.kill(-pid, 'SIGTERM')
  } catch {
    try {
      process.kill(pid, 'SIGTERM')
    } catch {
      // Process already dead
    }
  }
}

function cleanupFailedStart(pid) {
  if (pid && isProcessRunning(pid)) {
    terminateProcess(pid)
  }
  removePid()
}

// Lock file management to prevent race conditions
const LOCK_STALE_MS = 180000 // 3 minutes - lock is stale if older than this

function acquireLock() {
  const dir = path.dirname(lockFile)
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true })
  }

  // Check for existing lock
  try {
    const lockData = fs.readFileSync(lockFile, 'utf8')
    const { timestamp, pid } = JSON.parse(lockData)
    const age = Date.now() - timestamp

    // Lock is stale if too old or process is dead
    if (age < LOCK_STALE_MS && isProcessRunning(pid)) {
      return false // Lock is held by another process
    }
    // Stale lock - we can take over
    console.log(`${colors.dim}Cleaning up stale lock file${colors.reset}`)
  } catch {
    // No lock file or invalid - we can acquire
  }

  // Write our lock
  fs.writeFileSync(lockFile, JSON.stringify({
    timestamp: Date.now(),
    pid: process.pid,
  }))
  return true
}

function releaseLock() {
  try {
    // Only release if we own the lock
    const lockData = fs.readFileSync(lockFile, 'utf8')
    const { pid } = JSON.parse(lockData)
    if (pid === process.pid) {
      fs.unlinkSync(lockFile)
    }
  } catch {
    // Lock file doesn't exist or can't be read - that's fine
  }
}

/**
 * Tail the daemon log file during startup to show errors in real-time
 */
function tailLogFile() {
  let tail = null
  let lastSize = 0

  const startTailing = () => {
    // Start from current file size so we only see NEW content
    try {
      lastSize = fs.statSync(logFile).size
    } catch {
      lastSize = 0 // File doesn't exist yet
    }

    const checkFile = () => {
      try {
        const stat = fs.statSync(logFile)
        if (stat.size > lastSize) {
          const fd = fs.openSync(logFile, 'r')
          const buffer = Buffer.alloc(stat.size - lastSize)
          fs.readSync(fd, buffer, 0, buffer.length, lastSize)
          fs.closeSync(fd)

          const content = buffer.toString()
          for (const line of content.split('\n')) {
            if (line.trim()) {
              // Color errors red, warnings yellow
              if (line.includes('Error') || line.includes('error:')) {
                console.log(`${colors.red}[daemon] ${line}${colors.reset}`)
              } else if (line.includes('Warning') || line.includes('warning')) {
                console.log(`${colors.yellow}[daemon] ${line}${colors.reset}`)
              } else {
                console.log(`${colors.dim}[daemon] ${line}${colors.reset}`)
              }
            }
          }
          lastSize = stat.size
        }
      } catch {
        // File doesn't exist yet - that's fine
      }
    }

    // Poll every 500ms
    tail = setInterval(checkFile, 500)
    checkFile() // Check immediately
  }

  const stopTailing = () => {
    if (tail) {
      clearInterval(tail)
      tail = null
    }
  }

  return { start: startTailing, stop: stopTailing }
}

/**
 * Read cache file
 */
function readCache() {
  try {
    return JSON.parse(fs.readFileSync(cacheFile, 'utf8'))
  } catch {
    return null
  }
}

/**
 * Write cache file
 */
function writeCache(data) {
  const dir = path.dirname(cacheFile)
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true })
  }
  fs.writeFileSync(cacheFile, JSON.stringify(data, null, 2))
}

/**
 * Check if we can use cached result
 */
async function checkCache() {
  const cache = readCache()
  if (!cache?.lastRun) return null

  const { timestamp, projectMtime, output, exitCode, failures, jsonResult } = cache.lastRun

  // TTL check
  const age = Date.now() - timestamp
  if (age > CACHE_TTL_MS) return null

  // File change check
  const currentMtime = await getProjectMtime()
  if (currentMtime > projectMtime) return null

  return { output, exitCode, failures, age, jsonResult }
}

/**
 * Save result to cache
 */
async function saveCache(output, exitCode, failures, jsonResult = null) {
  const projectMtime = await getProjectMtime()
  writeCache({
    lastRun: {
      timestamp: Date.now(),
      projectMtime,
      output,
      exitCode,
      failures,
      jsonResult, // Store structured JSON for --json mode
    }
  })
}

function createJsonProgressLogger(options = {}) {
  const startTime = options.startTime ?? Date.now()
  const now = options.now ?? Date.now
  const write = options.write ?? console.error
  let testCount = 0

  return {
    handleLogLine(rawLine) {
      const line = rawLine || ''
      if (line.includes('✓') || line.includes('✗') || line.match(/^\s*\d+\)/)) {
        testCount += 1
        const elapsed = Math.round((now() - startTime) / 1000)
        write(`[${elapsed}s] ${line.trim()}`)
      }
    },
    getCount() {
      return testCount
    },
  }
}

function createRestartLoopTracker(options = {}) {
  const windowMs = options.windowMs ?? 60000
  const maxRestarts = options.maxRestarts ?? 3
  const now = options.now ?? Date.now
  let restarts = []

  return {
    recordRestart() {
      const current = now()
      restarts = restarts.filter(ts => current - ts < windowMs)
      restarts.push(current)
      return restarts.length >= maxRestarts
    },
    reset() {
      restarts = []
    },
    getCount() {
      return restarts.length
    },
  }
}

const restartLoopTracker = createRestartLoopTracker()

function getTestCountFromResult(jsonResult, data) {
  if (jsonResult?.stats && typeof jsonResult.stats.tests === 'number') {
    return jsonResult.stats.tests
  }
  if (data && typeof data.tests === 'number') {
    return data.tests
  }
  return null
}

function shouldReportNoTestsMatched(hasPattern, jsonResult, data) {
  const testCount = getTestCountFromResult(jsonResult, data)
  return hasPattern && testCount === 0
}

function isMochaJsonResult(value) {
  return Boolean(
    value &&
    typeof value === 'object' &&
    value.stats &&
    typeof value.stats === 'object' &&
    typeof value.stats.tests === 'number' &&
    Array.isArray(value.tests) &&
    Array.isArray(value.passes) &&
    Array.isArray(value.failures),
  )
}

function tryParseMochaJsonCandidate(candidate) {
  try {
    const parsed = JSON.parse(candidate)
    return isMochaJsonResult(parsed) ? parsed : null
  } catch {
    return null
  }
}

function extractMochaJsonFromMixedOutput(raw) {
  for (let start = raw.indexOf('{'); start !== -1; start = raw.indexOf('{', start + 1)) {
    let depth = 0
    let inString = false
    let escaped = false

    for (let index = start; index < raw.length; index += 1) {
      const char = raw[index]

      if (inString) {
        if (escaped) {
          escaped = false
        } else if (char === '\\') {
          escaped = true
        } else if (char === '"') {
          inString = false
        }
        continue
      }

      if (char === '"') {
        inString = true
      } else if (char === '{') {
        depth += 1
      } else if (char === '}') {
        depth -= 1
        if (depth === 0) {
          const parsed = tryParseMochaJsonCandidate(raw.slice(start, index + 1))
          if (parsed) return parsed
          break
        }
      }
    }
  }

  return null
}

function parseMochaJsonPayload(raw) {
  try {
    return JSON.parse(raw)
  } catch (error) {
    const recovered = extractMochaJsonFromMixedOutput(raw)
    if (recovered) {
      return {
        ...recovered,
        json_recovered_from_mixed_stdout: true,
      }
    }

    return {
      parseError: error.message,
      raw,
    }
  }
}

const DEFAULT_LLM_FAILURE_LIMIT = 10
const DEFAULT_LLM_STACK_LINES = 6

function summarizeFailures(failures, options = {}) {
  if (!Array.isArray(failures)) {
    return { total: 0, items: [], truncated: false }
  }

  const limit = Number.isFinite(options.limit) ? options.limit : DEFAULT_LLM_FAILURE_LIMIT
  const stackLines = Number.isFinite(options.stackLines) ? options.stackLines : DEFAULT_LLM_STACK_LINES
  const items = failures.slice(0, limit).map((failure) => {
    const fullTitle = typeof failure?.fullTitle === 'string' ? failure.fullTitle : undefined
    const title = typeof failure?.title === 'string' ? failure.title : undefined
    const err = failure?.err
    const message = typeof err?.message === 'string'
      ? err.message
      : typeof err === 'string'
        ? err
        : undefined
    const stack = typeof err?.stack === 'string'
      ? err.stack.split('\n').slice(0, stackLines)
      : undefined

    return {
      title: fullTitle || title || 'Unknown test',
      file: typeof failure?.file === 'string' ? failure.file : undefined,
      duration_ms: typeof failure?.duration === 'number' ? failure.duration : undefined,
      message,
      stack,
    }
  })

  return {
    total: failures.length,
    items,
    truncated: failures.length > items.length,
  }
}

function buildLlmSummary(output, failureSummary) {
  const lines = []
  const status = output?.success === true
    ? 'passed'
    : output?.success === false
      ? 'failed'
      : 'unknown'
  const statusSuffix = output?.error ? ` (${output.error})` : ''

  lines.push(`status: ${status}${statusSuffix}`)

  if (output?.cached) {
    const age = Number.isFinite(output.cached_age_seconds)
      ? ` (${output.cached_age_seconds}s)`
      : ''
    lines.push(`cached: true${age}`)
  }

  if (typeof output?.duration_ms === 'number') {
    lines.push(`duration_ms: ${output.duration_ms}`)
  }

  const filterParts = []
  if (output?.file) filterParts.push(`file=${output.file}`)
  if (output?.grep) filterParts.push(`grep=${output.grep}`)
  if (output?.invert) filterParts.push('invert=1')
  if (filterParts.length > 0) {
    lines.push(`filter: ${filterParts.join(' ')}`)
  }

  const stats = output?.stats
  if (stats && typeof stats.tests === 'number') {
    const passes = typeof stats.passes === 'number' ? stats.passes : 0
    const failures = typeof stats.failures === 'number' ? stats.failures : 0
    const pending = typeof stats.pending === 'number' ? stats.pending : 0
    lines.push(`tests: ${stats.tests} (passes ${passes}, failures ${failures}, pending ${pending})`)
  }

  if (output?.message) lines.push(`message: ${output.message}`)
  if (output?.hint) lines.push(`hint: ${output.hint}`)

  if (failureSummary?.items?.length) {
    lines.push('failures:')
    for (const failure of failureSummary.items) {
      const location = failure.file ? ` (${failure.file})` : ''
      const detail = failure.message ? ` - ${failure.message}` : ''
      lines.push(`- ${failure.title}${location}${detail}`)
    }
    if (failureSummary.truncated) {
      const remaining = failureSummary.total - failureSummary.items.length
      lines.push(`... ${remaining} more failures omitted`)
    }
  }

  return lines.join('\n')
}

function finalizeJsonOutput(output, options = {}) {
  const failureSummary = summarizeFailures(output.failures, options)
  const summary = buildLlmSummary(output, failureSummary)

  return {
    ...output,
    llm_summary: summary,
    llm_failures: failureSummary.items,
    llm_failures_total: failureSummary.total,
    llm_failures_truncated: failureSummary.truncated,
  }
}

function formatMachineOutput(output, options = {}) {
  const mode = options.mode ?? 'json'
  const formatted = finalizeJsonOutput(output, options)
  if (mode === 'llm') {
    return formatted.llm_summary
  }
  return JSON.stringify(formatted, null, 2)
}

// Set when no build stamp could be found, so freshness is neither proven nor
// disproven. Surfaced on every machine-readable payload — a caller must never
// read silence as "fresh".
let freshnessUnknown = false

function printMachineOutput(output, options = {}) {
  const mode = llmMode ? 'llm' : 'json'
  const payload = freshnessUnknown ? { ...output, freshness: 'unknown' } : output
  console.log(formatMachineOutput(payload, { ...options, mode }))
}

function isActivityEvent(data) {
  if (!data || typeof data.type !== 'string') return false
  return data.type !== 'heartbeat'
}

async function waitForLockOrDaemon(quiet = false) {
  const startTime = Date.now()
  const maxWait = 180000 // 3 minutes max wait

  while (Date.now() - startTime < maxWait) {
    // If daemon is now running, we're good
    const status = await getDaemonStatus()
    if (status.status === 'ready') {
      return { ready: true }
    }

    if (status.status === 'restarting') {
      if (!quiet) process.stdout.write('.')
      await new Promise(r => setTimeout(r, 2000))
      continue
    }

    // Try to acquire lock
    if (acquireLock()) {
      // Check one more time - daemon might have started while we waited
      const recheckStatus = await getDaemonStatus()
      if (recheckStatus.status === 'ready') {
        releaseLock()
        return { ready: true }
      }
      if (recheckStatus.status === 'restarting') {
        releaseLock()
        if (!quiet) process.stdout.write('.')
        await new Promise(r => setTimeout(r, 2000))
        continue
      }
      return { locked: true }
    }

    // Lock is held - wait and retry (suppress dots in JSON mode)
    if (!quiet) process.stdout.write('.')
    await new Promise(r => setTimeout(r, 2000))
  }

  return { timeout: true }
}

// Maximum number of daemon startup attempts before giving up. Rspack and
// meteor-tool have a known flakiness where the build subprocess can crash
// during cold starts (processes.js onExit bug, OOM pressure, etc). Without
// retries, a single flaky crash burns the entire test run. With 3 attempts,
// transient flakes become slightly-slower-but-successful runs.
const MAX_DAEMON_STARTUP_ATTEMPTS = 3

// Pure helper: resolve a positive-integer-ms config from an env var with a
// fallback default. Extracted so the parsing rules can be unit-tested
// without booting Meteor — see tests/unit/daemonStartupTimeouts.test.mjs.
function resolvePositiveMsEnv(envValue, fallbackMs) {
  const raw = parseInt(envValue, 10)
  return Number.isFinite(raw) && raw > 0 ? raw : fallbackMs
}

// Soft budget for `meteor test` to reach a serving /test/health.
// On large full-app codebases the first cold build (server bundle compile
// + Meteor.startup callbacks + post-build client recompile) reliably
// exceeds 2 minutes — "Started proxy" appears around 70s, "Started MongoDB"
// around 90s, and the health handler only goes live once the test driver
// package's `start()` runs after the server bundle finishes loading. After
// this soft budget we stop assuming "ready any second now" and start
// requiring fresh log activity to keep waiting — see HARD_TIMEOUT below.
const DAEMON_STARTUP_TIMEOUT_MS = resolvePositiveMsEnv(
  process.env.TEST_DAEMON_STARTUP_TIMEOUT_MS,
  240000,
)

// Hard ceiling: even with continuous log activity we never wait longer than
// this for a single attempt. If we're still not healthy here, something is
// genuinely wrong — likely deadlocked or memory-thrashing — and a retry
// won't help. Configurable in case a particular app legitimately needs it.
const DAEMON_STARTUP_HARD_TIMEOUT_MS = resolvePositiveMsEnv(
  process.env.TEST_DAEMON_STARTUP_HARD_TIMEOUT_MS,
  600000,
)

// Forward-progress window. Once past the soft budget we only keep waiting
// if the daemon log file has been written to within this window. Log going
// quiet for this long past the soft budget means the build is no longer
// making progress — give up, surface diagnostics, and let the caller see
// the real stall instead of burning the full hard ceiling on a dead build.
const DAEMON_PROGRESS_STALL_MS = 45000

/**
 * Structured event logger for daemon lifecycle diagnostics.
 *
 * Writes a JSON line to the daemon log file, tagged with a wall-clock ISO
 * timestamp and monotonic elapsed-ms counter. Also echoes to stderr when
 * not in quiet/JSON mode so operators can watch events live.
 *
 * Verbosity is intentionally high: daemon startup flakes are rare in any
 * single run but very expensive when they happen (they time out an entire
 * test iteration). Having per-phase structured events means a single
 * failed run's log is self-diagnosing, without needing to reproduce.
 */
let _daemonLogEpoch = null
function logDaemonEvent(event, data = {}, { quiet = false } = {}) {
  if (_daemonLogEpoch === null) _daemonLogEpoch = Date.now()
  const elapsedMs = Date.now() - _daemonLogEpoch
  const line = JSON.stringify({
    ts: new Date().toISOString(),
    elapsed_ms: elapsedMs,
    event,
    ...data,
  })
  try {
    fs.appendFileSync(logFile, `[daemon-event] ${line}\n`)
  } catch {
    // Best-effort — never let diagnostic logging crash the daemon.
  }
  if (!quiet) {
    process.stderr.write(`${colors.dim}[daemon-event] ${line}${colors.reset}\n`)
  }
}

/**
 * Snapshot relevant system state at a phase boundary. Used to capture
 * what was happening around a daemon crash or timeout, so the failure
 * is diagnosable from log artifacts alone.
 */
function captureDiagnosticSnapshot(label, daemonPid) {
  const snapshot = { label }
  try {
    snapshot.port_bound_by = execSync(`lsof -ti:${port} 2>/dev/null || true`).toString().trim()
  } catch { snapshot.port_bound_by = 'unknown' }
  try {
    snapshot.daemon_pid_alive = daemonPid ? isProcessRunning(daemonPid) : null
  } catch { snapshot.daemon_pid_alive = 'unknown' }
  try {
    snapshot.meteor_procs = execSync(`pgrep -lf "meteor|rspack|mongod" 2>/dev/null || true`)
      .toString().trim().split('\n').filter(Boolean).slice(0, 20)
  } catch { snapshot.meteor_procs = [] }
  try {
    const stat = fs.statSync(path.join(process.cwd(), '.meteor', 'local'))
    snapshot.dotmeteor_local_mtime = stat.mtime.toISOString()
  } catch { snapshot.dotmeteor_local_mtime = null }
  // Was the daemon log written to recently? Helps distinguish "build still
  // making forward progress" (slow, raise the timeout) from "daemon is alive
  // but hung" (real deadlock, the next investigation step).
  try {
    const stat = fs.statSync(logFile)
    snapshot.log_mtime = stat.mtime.toISOString()
    snapshot.log_silent_ms = Math.max(0, Date.now() - stat.mtime.getTime())
    snapshot.log_advancing = snapshot.log_silent_ms < DAEMON_PROGRESS_STALL_MS
  } catch {
    snapshot.log_mtime = null
    snapshot.log_silent_ms = null
    snapshot.log_advancing = null
  }
  return snapshot
}

// Start daemon in background
async function startDaemon(quiet = false) {
  // Check if already running
  const initialStatus = await getDaemonStatus()
  if (initialStatus.status === 'ready') {
    if (!quiet) console.log(`${colors.green}Daemon already running on port ${port}${colors.reset}`)
    return true
  }
  if (initialStatus.status === 'restarting') {
    if (!quiet) console.log(`${colors.dim}Daemon restarting, waiting for it to come back...${colors.reset}`)
    const restarted = await waitForDaemonRestart({ log: quiet ? null : console.log })
    if (restarted) {
      if (!quiet) console.log(`${colors.green}Daemon already running on port ${port}${colors.reset}`)
      return true
    }
    if (!quiet) console.error(`${colors.red}Daemon did not restart within timeout${colors.reset}`)
    return {
      started: false,
      error: 'restart_timeout',
      message: 'Daemon did not restart within timeout',
      logs: getRecentLogs(10),
    }
  }

  // Try to get lock or wait for another process to start daemon
  if (!quiet) console.log(`${colors.dim}Checking for other startup processes...${colors.reset}`)
  const lockResult = await waitForLockOrDaemon(quiet)

  if (lockResult.ready) {
    if (!quiet) console.log(`${colors.green}Daemon already running on port ${port}${colors.reset}`)
    return true
  }

  if (lockResult.timeout) {
    console.error(`${colors.red}Timeout waiting for daemon startup${colors.reset}`)
    return false
  }

  // We have the lock - we're responsible for starting the daemon
  try {
    // Ensure log directory exists once (shared across all attempts)
    const logDir = path.dirname(logFile)
    if (!fs.existsSync(logDir)) {
      fs.mkdirSync(logDir, { recursive: true })
    }

    logDaemonEvent('startup-begin', {
      pid_file: pidFile,
      log_file: logFile,
      port,
      max_attempts: MAX_DAEMON_STARTUP_ATTEMPTS,
      pre_state: captureDiagnosticSnapshot('pre-startup', null),
    }, { quiet })

    // Retry loop: rspack/meteor flakes on cold start get a second chance
    // before we give up and report failure to the caller.
    let lastFailure = null
    for (let attempt = 1; attempt <= MAX_DAEMON_STARTUP_ATTEMPTS; attempt++) {
      // Clean up stale PID file from a prior attempt or crashed process
      const existingPid = readPid()
      if (existingPid && !isProcessRunning(existingPid)) {
        if (!quiet) console.log(`${colors.dim}Cleaning up stale PID file${colors.reset}`)
        logDaemonEvent('stale-pid-cleanup', { attempt, stale_pid: existingPid }, { quiet })
        removePid()
      }

      if (!quiet) {
        const label = attempt === 1
          ? 'Starting test daemon...'
          : `Starting test daemon (attempt ${attempt}/${MAX_DAEMON_STARTUP_ATTEMPTS})...`
        console.log(`${colors.cyan}${label}${colors.reset}`)
      }

      // Start daemon in background
      const out = fs.openSync(logFile, 'a')
      const err = fs.openSync(logFile, 'a')

      const child = spawn('npm', ['run', 'test:daemon'], {
        detached: true,
        stdio: ['ignore', out, err],
        cwd: process.cwd(),
      })

      writePid(child.pid)
      child.unref()

      logDaemonEvent('spawn', {
        attempt,
        child_pid: child.pid,
        cmd: 'npm run test:daemon',
      }, { quiet })

      if (!quiet) {
        console.log(`${colors.dim}Daemon PID: ${child.pid}${colors.reset}`)
        console.log(`${colors.dim}Log file: ${logFile}${colors.reset}`)
      }

      // Tail the log (unless in JSON/quiet mode). Create a fresh tailer
      // per attempt so we don't miss any startup output.
      const tailer = quiet ? null : tailLogFile()
      if (tailer) tailer.start()

      if (!quiet) console.log(`${colors.dim}Waiting for daemon to be ready...${colors.reset}`)
      const startTime = Date.now()
      const softTimeout = DAEMON_STARTUP_TIMEOUT_MS
      const hardTimeout = DAEMON_STARTUP_HARD_TIMEOUT_MS
      const daemonPid = child.pid
      let pollTick = 0
      let lastPhase = 'spawned'
      let extendedAnnounced = false
      let result = null // one of 'ready' | 'crashed' | 'timeout'

      while (true) {
        pollTick++
        const elapsedMs = Date.now() - startTime

        // Hard ceiling — no amount of forward progress justifies waiting
        // longer than this for a single attempt.
        if (elapsedMs >= hardTimeout) {
          result = 'timeout'
          break
        }

        // Emit a heartbeat every ~10s so we know the poller is alive
        // and can see roughly where in the startup we got stuck.
        if (pollTick % 5 === 0) {
          logDaemonEvent('startup-poll-tick', {
            attempt,
            poll_tick: pollTick,
            elapsed_ms: elapsedMs,
            phase: lastPhase,
          }, { quiet })
        }

        // Process died mid-startup — typical rspack/processes.js crash
        if (!isProcessRunning(daemonPid)) {
          result = 'crashed'
          break
        }

        if (await isDaemonRunning()) {
          // Health check passed; give meteor a moment to settle.
          await new Promise(r => setTimeout(r, 500))
          result = 'ready'
          break
        }

        // Past the soft budget? Only keep waiting if the daemon log is
        // still being written to — that's our signal the build is making
        // forward progress vs deadlocked. Silence past the soft budget is
        // the real stall signal.
        if (elapsedMs >= softTimeout) {
          let logSilentMs = Infinity
          try {
            logSilentMs = Date.now() - fs.statSync(logFile).mtime.getTime()
          } catch {
            // Log file vanished — treat as worst-case silence.
          }
          if (logSilentMs >= DAEMON_PROGRESS_STALL_MS) {
            result = 'timeout'
            lastPhase = 'progress-stalled'
            logDaemonEvent('startup-progress-stalled', {
              attempt,
              poll_tick: pollTick,
              elapsed_ms: elapsedMs,
              log_silent_ms: Number.isFinite(logSilentMs) ? logSilentMs : null,
            }, { quiet })
            break
          }
          if (!extendedAnnounced) {
            extendedAnnounced = true
            lastPhase = 'extended-build'
            logDaemonEvent('startup-extended', {
              attempt,
              poll_tick: pollTick,
              elapsed_ms: elapsedMs,
              soft_timeout_ms: softTimeout,
              hard_timeout_ms: hardTimeout,
              reason: 'log still advancing past soft timeout',
            }, { quiet })
          }
        }

        if (lastPhase !== 'extended-build') lastPhase = 'polling-health'
        await new Promise(r => setTimeout(r, 2000))
      }

      if (tailer) tailer.stop()

      // ── Success path ────────────────────────────────────────────
      if (result === 'ready') {
        logDaemonEvent('startup-ready', {
          attempt,
          daemon_pid: daemonPid,
          elapsed_ms: Date.now() - startTime,
          poll_ticks: pollTick,
        }, { quiet })
        if (!quiet) console.log(`\n${colors.green}Daemon ready with latest code!${colors.reset}\n`)
        releaseLock()
        return true
      }

      // ── Failure paths — gather diagnostics then decide on retry ─
      const recentLogs = getRecentLogs(50)
      const errorLines = recentLogs.filter(isDaemonErrorLine)
      const failureSnapshot = captureDiagnosticSnapshot(
        result === 'crashed' ? 'post-crash' : 'post-timeout',
        daemonPid,
      )

      logDaemonEvent(
        result === 'crashed' ? 'daemon-crashed' : 'startup-timeout',
        {
          attempt,
          daemon_pid: daemonPid,
          elapsed_ms: Date.now() - startTime,
          poll_ticks: pollTick,
          error_lines: errorLines.slice(-5),
          snapshot: failureSnapshot,
        },
        { quiet },
      )

      cleanupFailedStart(daemonPid)
      lastFailure = {
        started: false,
        error: result === 'crashed' ? 'daemon_crashed' : 'startup_timeout',
        message: errorLines.length > 0
          ? errorLines.slice(-1)[0]
          : `Daemon ${result === 'crashed' ? 'crashed during startup' : 'failed to start within timeout'}`,
        logs: errorLines.slice(-10),
      }

      // ── Retry decision ──────────────────────────────────────────
      if (attempt < MAX_DAEMON_STARTUP_ATTEMPTS) {
        logDaemonEvent('will-retry', {
          attempt,
          next_attempt: attempt + 1,
          reason: lastFailure.error,
          backoff_ms: 2000,
        }, { quiet })
        if (!quiet) {
          console.log(
            `\n${colors.yellow}Daemon ${result === 'crashed' ? 'crashed' : 'timed out'} on attempt ${attempt}/${MAX_DAEMON_STARTUP_ATTEMPTS}; retrying in 2s...${colors.reset}`,
          )
        }
        await new Promise(r => setTimeout(r, 2000))
        continue
      }

      // ── Out of retries — surface the failure to the caller ──────
      if (!quiet) {
        console.error(
          `\n${colors.red}Daemon failed after ${MAX_DAEMON_STARTUP_ATTEMPTS} attempts (${lastFailure.error})${colors.reset}`,
        )
        if (errorLines.length > 0) {
          console.error(`${colors.red}Error:${colors.reset}`)
          errorLines.slice(-5).forEach(line =>
            console.error(`  ${colors.red}${line}${colors.reset}`),
          )
        }
        console.error(`\n${colors.dim}Full logs: ${logFile}${colors.reset}`)
      }

      logDaemonEvent('startup-abandoned', {
        total_attempts: MAX_DAEMON_STARTUP_ATTEMPTS,
        final_error: lastFailure.error,
      }, { quiet })

      releaseLock()
      return lastFailure
    }

    // Unreachable — the for-loop always returns or assigns lastFailure
    releaseLock()
    return lastFailure
  } catch (err) {
    releaseLock()
    throw err
  }
}

// Stop daemon
async function stopDaemon(quiet = false) {
  const pid = readPid()
  if (pid && isProcessRunning(pid)) {
    if (!quiet) {
      console.log(`${colors.yellow}Stopping daemon (PID: ${pid})...${colors.reset}`)
    }
    // Kill the process group to get all child processes
    terminateProcess(pid)
    removePid()
    if (!quiet) {
      console.log(`${colors.green}Daemon stopped${colors.reset}`)
    }
  } else {
    // Try to find and kill by port
    try {
      const result = execSync(`lsof -ti:${port}`).toString().trim()
      if (result) {
        const pids = result.split('\n')
        for (const p of pids) {
          try {
            process.kill(parseInt(p, 10), 'SIGTERM')
            if (!quiet) {
              console.log(`${colors.yellow}Killed process ${p} on port ${port}${colors.reset}`)
            }
          } catch {
            // Process already dead
          }
        }
        removePid()
        if (!quiet) {
          console.log(`${colors.green}Daemon stopped${colors.reset}`)
        }
      } else {
        if (!quiet) {
          console.log(`${colors.dim}No daemon running${colors.reset}`)
        }
      }
    } catch {
      if (!quiet) {
        console.log(`${colors.dim}No daemon running${colors.reset}`)
      }
    }
  }
}

// Show daemon status
async function daemonStatus() {
  const status = await getDaemonStatus()
  const pid = readPid()

  if (status.status === 'ready') {
    console.log(`${colors.green}Daemon is running on port ${port}${colors.reset}`)
    if (pid) {
      console.log(`${colors.dim}PID: ${pid}${colors.reset}`)
    }
    // Get health info
    try {
      const health = await new Promise((resolve, reject) => {
        http.get(`http://localhost:${port}/test/health`, (res) => {
          let data = ''
          res.on('data', chunk => data += chunk)
          res.on('end', () => resolve(JSON.parse(data)))
        }).on('error', reject)
      })
      console.log(`${colors.dim}Suites: ${health.suites}${colors.reset}`)
    } catch {
      // Ignore
    }
  } else if (status.status === 'restarting') {
    console.log(`${colors.yellow}Daemon is restarting...${colors.reset}`)
    if (pid) {
      console.log(`${colors.dim}PID: ${pid}${colors.reset}`)
    }
  } else {
    console.log(`${colors.red}Daemon is not running${colors.reset}`)
    if (pid && isProcessRunning(pid)) {
      console.log(`${colors.yellow}PID file exists (${pid}) but daemon not responding${colors.reset}`)
    }
  }
}

// Handle daemon commands
async function handleDaemonCommand(cmd) {
  switch (cmd) {
    case 'start':
      await startDaemon()
      process.exit(0)
      break
    case 'stop':
      await stopDaemon()
      process.exit(0)
      break
    case 'status':
      await daemonStatus()
      process.exit(0)
      break
    case 'restart':
      await stopDaemon()
      await new Promise(r => setTimeout(r, 1000))
      await startDaemon()
      process.exit(0)
      break
    case 'logs':
      const tailMode = args.includes('-t') || args.includes('--tail')
      if (fs.existsSync(logFile)) {
        console.log(`${colors.dim}Log file: ${logFile}${colors.reset}\n`)
        if (tailMode) {
          // Stream logs continuously
          console.log(`${colors.dim}Tailing logs (Ctrl+C to exit)...${colors.reset}\n`)
          const tail = spawn('tail', ['-n', '100', '-f', logFile], { stdio: 'inherit' })
          tail.on('close', () => process.exit(0))
          process.on('SIGINT', () => {
            tail.kill()
            process.exit(0)
          })
        } else {
          // One-shot: print and exit
          console.log(fs.readFileSync(logFile, 'utf8'))
          process.exit(0)
        }
      } else {
        console.log(`${colors.dim}No log file found at ${logFile}${colors.reset}`)
        process.exit(0)
      }
      break
    default:
      console.error(`Unknown daemon command: ${cmd}`)
      console.error('Usage: test-run daemon [start|stop|status|restart|logs]')
      process.exit(1)
  }
}

// Parse args
let args = []
let testNamePatterns = []
let filePattern = ''
let invert = false
let watchMode = false
let jsonMode = false
let llmMode = false
let snapshotUpdate = false
let bail = false

/**
 * Check if an argument looks like a test file or directory path
 * Supports: .app-spec., .app-test., .spec., .test., or paths ending with /
 */
function isFilePath(arg) {
  return arg.includes('.app-spec.') ||
         arg.includes('.app-test.') ||
         arg.includes('.spec.') ||
         arg.includes('.test.') ||
         arg.endsWith('/') ||
         arg.includes('/') && !arg.includes('.') // directory path like imports/api/calendar
}

/**
 * Normalize a file path to be relative to project root
 * Strips leading slashes and ensures forward slashes
 */
function normalizePath(filepath) {
  if (!filepath) return filepath
  // Remove leading slash if present
  let normalized = filepath.replace(/^\/+/, '')
  // Ensure forward slashes (Windows compat)
  normalized = normalized.replace(/\\/g, '/')
  return normalized
}

function main(argv = process.argv.slice(2)) {
  args = argv
  testNamePatterns = []
  filePattern = ''
  invert = false
  watchMode = false
  jsonMode = false
  snapshotUpdate = false
  bail = false

  // Check for daemon commands first
  if (args[0] === 'daemon') {
    handleDaemonCommand(args[1] || 'status')
    return
  }

  // Parse test args
  for (let i = 0; i < args.length; i++) {
    const arg = args[i]

    // Test name patterns (-t, --testNamePattern, --grep, -g)
    if (arg === '-t' || arg === '--testNamePattern' || arg === '--grep' || arg === '-g') {
      if (args[i + 1]) testNamePatterns.push(args[++i])
    }
    // File pattern (-f, --file)
    else if (arg === '-f' || arg === '--file') {
      if (args[i + 1]) filePattern = normalizePath(args[++i])
    }
    // Invert
    else if (arg === '--invert' || arg === '-i') {
      invert = true
    }
    // Watch mode
    else if (arg === '--watch' || arg === '-w') {
      watchMode = true
    }
    // JSON output mode
    else if (arg === '--json') {
      jsonMode = true
    }
    // LLM output mode (compact text summary)
    else if (arg === '--llm') {
      llmMode = true
    }
    // Snapshot update mode
    else if (arg === '--snapshot-update' || arg === '-u') {
      snapshotUpdate = true
    }
    // Bail on first failure
    else if (arg === '--bail' || arg === '-b') {
      bail = true
    }
    // Help
    else if (arg === '--help' || arg === '-h') {
      console.log(`
Usage: test-run [options] [pattern|filepath...]
       test-run daemon [start|stop|status|restart]

Options:
  -t, --testNamePattern <pattern>  Filter by test name (can repeat)
  -g, --grep <pattern>             Alias for -t
  -f, --file <path>                Run tests in specific file
  -i, --invert                     Invert pattern match
  -w, --watch                      Watch mode: re-run on daemon restart
  --json                           Output results as JSON (for LLM/scripting)
  --llm                            Output compact text summary optimized for LLMs
  -u, --snapshot-update            Update snapshots (sets SNAPSHOT_UPDATE=1)
  -b, --bail                       Stop on first test failure
  --no-cache                       Force run, skip cache check
  -h, --help                       Show this help

Daemon Commands:
  daemon start     Start the test daemon in background
  daemon stop      Stop the running daemon
  daemon status    Check if daemon is running
  daemon restart   Restart the daemon
  daemon logs [-t] Show daemon log file (-t to tail/follow)

Multiple patterns use OR logic.
File paths are auto-detected (*.app-spec.ts, *.spec.ts).
The daemon auto-starts if not running when tests are requested.

Examples:
  test-run                                      Run all tests
  test-run Calendar                             Tests matching "Calendar"
  test-run -t Calendar -t sync                  Tests matching "Calendar" OR "sync"
  test-run Calendar -i                          Exclude tests matching "Calendar"
  test-run imports/api/calendar/FullSync.app-spec.ts   Run specific file
  test-run -f FullSync.app-spec.ts              Run file by partial path
  test-run FullSync.app-spec.ts -t "clears"     File + grep filter
  test-run Calendar -w                          Watch mode: re-run on changes
  test-run --json                               JSON output for LLM consumption
  test-run --llm                                Compact LLM-friendly output
  test-run Calendar --json | jq '.stats'        Filter JSON with jq
  test-run daemon stop                          Stop the daemon
`)
      process.exit(0)
    }
    // Positional args: detect if file path or grep pattern
    else if (!arg.startsWith('-')) {
      if (isFilePath(arg)) {
        filePattern = normalizePath(arg)
      } else {
        testNamePatterns.push(arg)
      }
    }
  }

  if (llmMode) {
    jsonMode = true
  }

  // Run tests
  runTests()
}

// Time allowed for the rspack watcher to notice an edit and start a rebuild.
// Once it starts, the build stamp says so and we wait as long as it takes, so
// this budget only covers the gap between saving a file and the watcher
// reacting. A watcher that never reacts is wedged, and now we can say so in
// seconds instead of guessing for two minutes.
const WATCH_NOTICE_MS = +(process.env.TEST_DAEMON_WATCH_NOTICE_MS || 8000)
// Backstop for a rebuild that IS running but never finishes. Only a hung
// compile reaches this.
const REBUILD_WAIT_MS = +(process.env.TEST_DAEMON_REBUILD_WAIT_MS || 300000)
// Where the Meteor/rspack integration emits its bundles. The daemon runs with
// RSPACK_BUILD_CONTEXT=_build-daemon; that env doesn't reach this client, so
// default to the same value and allow an override for other setups.
const BUILD_CONTEXT_DIR =
  process.env.TEST_DAEMON_BUILD_CONTEXT || process.env.RSPACK_BUILD_CONTEXT || '_build-daemon'
// The daemon runs server tests only, so only the server bundle's inputs decide
// whether its suite is current. The client stamp is deliberately ignored:
// Tailwind's content glob pulls docs, .beads and .claude into the client
// dependency graph, so a `bd` write would read as a stale test suite.
const BUILD_SIDES = ['server']

/** Fetch /test/health as JSON, or null on any error/timeout. */
function getHealthJson() {
  return new Promise((resolve) => {
    const req = http.get(`http://localhost:${port}/test/health`, (res) => {
      let data = ''
      res.on('data', (c) => (data += c))
      res.on('end', () => {
        try {
          resolve(JSON.parse(data))
        } catch {
          resolve(null)
        }
      })
    })
    req.on('error', () => resolve(null))
    req.setTimeout(3000, () => {
      req.destroy()
      resolve(null)
    })
  })
}

/**
 * An unstattable target splits two ways: a *bare filename* (no separator) is a
 * partial pattern the daemon resolves via suite matching — legitimate, so we
 * fall back to the build stamp alone. An *exact path* (has a separator) that
 * can't be statted means the user named a concrete spec that's been
 * deleted/renamed, so the daemon may still be running the removed spec. Treat
 * that as a hard stale.
 */
function isMissingExactTarget(pattern) {
  return pattern.includes('/') || pattern.includes(path.sep)
}

/** Parse a JSON file, or null if it is absent or unreadable. */
function readJsonFile(file) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'))
  } catch {
    return null
  }
}

/**
 * Read every build stamp under the build-context directory
 * (`_build-daemon/<mode>/.build-stamp-<side>.json`), paired with the
 * compiler's current state from the sibling `.build-state-<side>.json`.
 *
 * The stamps are written by BuildStampPlugin in the app's rspack.config.js.
 * An app without that plugin has no stamps, which the caller reports as
 * unknown freshness — never as fresh.
 */
function readBuildStamps(cwd = process.cwd(), contextDir = BUILD_CONTEXT_DIR) {
  const root = path.join(cwd, contextDir)
  const stamps = []
  let modes
  try {
    modes = fs.readdirSync(root, { withFileTypes: true })
  } catch {
    return stamps
  }
  for (const mode of modes) {
    if (!mode.isDirectory()) continue
    for (const side of BUILD_SIDES) {
      const dir = path.join(root, mode.name)
      const stamp = readJsonFile(path.join(dir, `.build-stamp-${side}.json`))
      if (!stamp || !Array.isArray(stamp.inputs)) continue
      const state = readJsonFile(path.join(dir, `.build-state-${side}.json`))
      stamps.push({ bundle: `${mode.name}/${side}`, stamp, state: state?.state || 'ok' })
    }
  }
  return stamps
}

const SKIP_DIRS = /^(node_modules|_build.*)$/

// Explicit code-unit ordering, mirroring byPath in rspack.buildStamp.mjs. A
// locale-dependent comparator would make the hash depend on the machine and
// every run would read stale.
const byPath = (a, b) => (a < b ? -1 : a > b ? 1 : 0)

/**
 * A watched directory's identity: every path beneath it. The walk is recursive
 * because rspack forwards a context dependency as a recursive watch — `imports`
 * stands in for the whole tree under it, so a shallow listing misses a spec
 * added two levels down.
 *
 * MIRRORED from hashDirTree in the app's rspack.buildStamp.mjs. The stamp
 * records what the compiler saw and this recomputes it, so the two must agree
 * exactly or every run reports stale.
 */
function hashDirTree(dir) {
  const paths = []
  const walk = (current, prefix) => {
    let entries
    try {
      entries = fs.readdirSync(current, { withFileTypes: true })
    } catch {
      return
    }
    for (const entry of entries) {
      if (entry.name.startsWith('.')) continue
      if (entry.isDirectory() && SKIP_DIRS.test(entry.name)) continue
      const rel = prefix ? `${prefix}/${entry.name}` : entry.name
      paths.push(rel)
      if (entry.isDirectory()) walk(path.join(current, entry.name), rel)
    }
  }
  if (!fs.existsSync(dir)) return null
  walk(dir, '')
  paths.sort(byPath)
  return crypto.createHash('sha1').update(paths.join('\n')).digest('hex')
}

/**
 * Compare the whole recorded input set against disk. Returns the newest file
 * mtime now on disk, the first recorded file that has since disappeared, the
 * first watched directory whose listing changed, and the first path the build
 * looked for and did not find that now exists.
 *
 * Directories compare by listing rather than mtime on purpose. Creating and
 * removing a scratch file inside one moves its mtime while leaving the listing
 * identical; rspack compares contents and does not rebuild, so an mtime check
 * would wait for a rebuild that never comes and cry wedged on a healthy
 * daemon — observed on a live daemon while building this.
 */
function scanStampInputs(stamp, cwd = process.cwd()) {
  let newest = 0
  let missing = null
  for (const rel of stamp.inputs) {
    try {
      const { mtimeMs } = fs.statSync(path.join(cwd, rel))
      if (mtimeMs > newest) newest = mtimeMs
    } catch {
      if (!missing) missing = rel
    }
  }
  let changedDir = null
  for (const [rel, hash] of Object.entries(stamp.dirs || {})) {
    if (hashDirTree(path.join(cwd, rel)) !== hash) {
      changedDir = rel
      break
    }
  }
  const appeared = (stamp.absent || []).find((rel) => fs.existsSync(path.join(cwd, rel)))
  return { newest, missing, changedDir, appeared: appeared || null }
}

/**
 * Pure core: is one bundle behind what is on disk?
 *
 * `newestInputMtime` is what the compiler saw while reading its inputs, so any
 * recorded input now newer than that was edited after the build. A recorded
 * input that has vanished is stale too — the bundle still contains it.
 * A path the build looked for and did not find, that now exists, is a change
 * the input list can never show. `targetMtime` covers the same shape for a
 * file the user named explicitly.
 */
function classifyStampFreshness({
  stamp,
  newestOnDisk,
  missingInput,
  changedDir,
  appearedInput,
  targetMtime = 0,
}) {
  if (missingInput) return { stale: true, deleted: missingInput }
  if (changedDir) return { stale: true, changedDir }
  if (appearedInput) return { stale: true, appeared: appearedInput }
  const newest = Math.max(newestOnDisk, targetMtime)
  if (newest <= stamp.newestInputMtime) return { stale: false }
  return { stale: true, mtimeMs: newest }
}

/**
 * Pure core: fold every bundle's verdict into one. Stale if any bundle is
 * stale; `building` and `failed` describe what the compiler is doing about it,
 * which is what decides whether waiting is worth anything.
 */
function evaluateStamps(entries, targetMtime = 0, cwd = process.cwd()) {
  let worst = null
  let building = false
  let failed = null
  for (const entry of entries) {
    if (entry.state === 'building') building = true
    const { newest, missing, changedDir, appeared } = scanStampInputs(entry.stamp, cwd)
    const verdict = classifyStampFreshness({
      stamp: entry.stamp,
      newestOnDisk: newest,
      missingInput: missing,
      changedDir,
      appearedInput: appeared,
      targetMtime,
    })
    if (!verdict.stale) continue
    if (entry.state === 'failed') failed = entry.bundle
    if (!worst || (verdict.mtimeMs || 0) > (worst.mtimeMs || 0)) {
      worst = { ...verdict, bundle: entry.bundle, builtAt: entry.stamp.builtAt }
    }
  }
  if (!worst) return { stale: false, building, failed }
  return { ...worst, building, failed }
}

/**
 * Staleness guard. A wedged Meteor watcher keeps serving the last-built suite
 * while /test/health still reports "ready" — so a run returns confident
 * pass/fail for code that no longer exists on disk (observed: a test title
 * that had been renamed away still "ran").
 *
 * The build reports its own inputs (see BuildStampPlugin), so freshness is a
 * fact lookup: stat what the compiler read, compare against what it saw. The
 * old guard reconstructed the input set from a hand-written list of source
 * roots and extensions; any drift from rspack's real watch set gave a wrong
 * answer in both directions — false wedges that blocked pushes, and silent
 * false "fresh" on a genuinely stale suite (fo-zdpf0).
 *
 * The wait is now bounded by evidence rather than by a fixed budget: while the
 * compiler says `building` we wait for it, and when it says otherwise a stale
 * bundle means the watcher never noticed the edit.
 *
 * KNOWN GAP (fo-81ow2): the stamp says what was COMPILED, not what the daemon
 * is running. Meteor restarts after the compile, so a run dispatched in that
 * ~10s window reads fresh against the previous bundle. Gating on
 * `health.builtAt >= stamp.builtAt` was tried and reverted — a
 * content-identical rebuild advances the stamp without rewriting the bundle,
 * so Meteor never restarts and the check can never clear. Closing this needs a
 * build generation both sides can name, not a timestamp.
 */
async function ensureDaemonFresh() {
  // Nothing is running, so nothing stale can be served: the guard does not
  // apply and startup is about to build from current sources anyway.
  //
  // This is load-bearing, not an optimisation. The stamp outlives the daemon —
  // it is a file in the build directory — so a stopped daemon plus an edited
  // tree reads as stale forever, and the run exits 2 BEFORE it would have
  // started the daemon that clears it. That bricks `test-run daemon stop &&
  // test-run`, which is the recovery path this very error message recommends.
  if (!(await getHealthJson())) return { stale: false }

  // filePattern may be a *partial* path — the documented `-f Foo.app-spec.ts`
  // and bare-positional workflows pass a filename the daemon resolves via suite
  // matching, so a direct stat throws. Don't bail to "fresh" in that case: the
  // recorded input list still gates freshness on its own.
  let targetMtime = 0
  if (filePattern) {
    try {
      targetMtime = fs.statSync(path.join(process.cwd(), filePattern)).mtimeMs
    } catch {
      // Exact path that's gone → the daemon may still hold the removed spec and
      // we can't verify otherwise: hard stale, no point waiting for a rebuild
      // that won't bring the file back. Bare filename → partial pattern, fall
      // through and let the stamps guard it.
      if (isMissingExactTarget(filePattern)) {
        return { stale: true, missing: true }
      }
    }
  }

  const noticeDeadline = Date.now() + WATCH_NOTICE_MS
  const hardDeadline = Date.now() + REBUILD_WAIT_MS
  for (;;) {
    const entries = readBuildStamps()
    if (!entries.length) return { unknown: true }
    const verdict = evaluateStamps(entries, targetMtime)
    if (!verdict.stale) return { stale: false }
    if (Date.now() > (verdict.building ? hardDeadline : noticeDeadline)) return verdict
    await new Promise((r) => setTimeout(r, 500))
  }
}

/**
 * Wedged-empty-bundle guard (Mode B). Distinct from the staleness guard above:
 * there the daemon serves an OLD-but-valid suite (builtAt lags disk); here a
 * rebuild DID fire — builtAt is fresh, so ensureDaemonFresh passes — but the
 * bundle came back broken and mocha's suite tree collapsed to 0. The daemon
 * still reports status:ready, so a bare full run returns a clean-looking
 * {tests:0, success:true}: a false all-clear that reads identically to "all
 * tests passed". A healthy full-app daemon always has hundreds of suites, so 0
 * is unambiguous. We re-poll briefly first so a cold boot that hasn't finished
 * registering eager specs isn't mistaken for a wedge.
 */
/**
 * Pure core: classify a /test/health body as a loaded, empty, or
 * indeterminate suite tree. 'unknown' (no health / suites omitted by an older
 * daemon) is deliberately NOT 'empty' — we never escalate to a wedge report on
 * missing data, only on an explicit suites:0 from a daemon that reports ready.
 */
function classifyDaemonFullness(health) {
  if (!health || typeof health.suites !== 'number') return 'unknown'
  return health.suites > 0 ? 'loaded' : 'empty'
}

/** Pure core: a 'done' payload whose bundle was empty (suitesTotal explicitly 0). */
function isWedgedEmptyResult(data) {
  return Boolean(data) && typeof data.suitesTotal === 'number' && data.suitesTotal === 0
}

async function ensureDaemonNotEmpty() {
  const ATTEMPTS = 4
  for (let i = 0; i < ATTEMPTS; i++) {
    const fullness = classifyDaemonFullness(await getHealthJson())
    // Missing/omitted suites (older daemon build) → can't judge; treat as fine.
    if (fullness !== 'empty') return { empty: false }
    if (i < ATTEMPTS - 1) await new Promise((r) => setTimeout(r, 500))
  }
  return { empty: true }
}

/**
 * Report a wedged empty bundle and set a non-zero exit. Shared by the pre-run
 * gate (Detector 1) and the post-run confirmation (suitesTotal===0 on 'done').
 */
function reportWedgedEmptyBundle(grep) {
  const fix = `Restart it: ./scripts/test-run daemon stop (auto-restarts next run). Logs: ./scripts/test-run daemon logs -t`
  const message = `Daemon appears WEDGED: it reports ready but its loaded suite tree is empty (0 suites). A run would report "no tests" / a false all-clear instead of actually testing — usually a rebuild that produced a broken or empty bundle. ${fix}`
  if (jsonMode) {
    printMachineOutput({
      success: false,
      wedged: true,
      error: 'wedged_empty_bundle',
      message,
      hint: fix,
      grep: grep || null,
      file: filePattern || null,
      stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
    })
  } else {
    console.error(`\n${colors.red}⚠ Test daemon appears WEDGED${colors.reset} — reports ready but has 0 suites loaded. A run would falsely report no tests.`)
    console.error(`${colors.yellow}${fix}${colors.reset}\n`)
  }
  process.exitCode = 2
}

const DAEMON_FIX_HINT = `Restart it: ./scripts/test-run daemon stop (auto-restarts next run). Logs: ./scripts/test-run daemon logs -t`

/**
 * Pure core: turn a stale verdict into the one sentence that explains it. The
 * shapes differ in what the user should do about them, so they are worth
 * telling apart — a failed compile wants the build log, a wedged watcher wants
 * a restart.
 */
function describeStaleness(freshness, pattern) {
  if (freshness.missing) {
    return `Target not found: ${pattern} does not exist on disk (deleted/renamed?). The daemon may still be running the old spec, so results can't be trusted.`
  }
  if (freshness.failed) {
    return `Last build of ${freshness.failed} FAILED, so the daemon is still serving the bundle from before your edit.`
  }
  if (freshness.deleted) {
    return `${freshness.deleted} was deleted but is still compiled into ${freshness.bundle}. The daemon is serving a stale suite.`
  }
  if (freshness.changedDir) {
    return `${freshness.changedDir}/ gained or lost a file since ${freshness.bundle} was compiled. The daemon is serving a stale suite.`
  }
  if (freshness.appeared) {
    return `${freshness.appeared} now exists but ${freshness.bundle} was compiled without it. The daemon is serving a stale suite.`
  }
  const lag = Math.round((freshness.mtimeMs - freshness.builtAt) / 1000)
  if (freshness.building) {
    return `A rebuild of ${freshness.bundle} has been running for over ${Math.round(REBUILD_WAIT_MS / 1000)}s and has not finished. The daemon is still serving code from ~${lag}s before your edit.`
  }
  return `Daemon appears wedged: source changed ~${lag}s after ${freshness.bundle} was last compiled, and the watcher did not start a rebuild within ${Math.round(WATCH_NOTICE_MS / 1000)}s. It is serving a stale suite.`
}

async function runTests() {
  // Refuse to serve results from a wedged daemon (stale bundle). See
  // ensureDaemonFresh — a rebuild in flight waits, a wedged one reports.
  const freshness = await ensureDaemonFresh()
  if (freshness.unknown) {
    // No build stamps: this app's rspack.config.js has no BuildStampPlugin, so
    // freshness cannot be established. Say so rather than imply "fresh".
    freshnessUnknown = true
    if (!jsonMode) {
      console.error(
        `${colors.yellow}⚠ Cannot verify daemon freshness — no build stamp under ${BUILD_CONTEXT_DIR}/. Results may reflect old code.${colors.reset}`,
      )
    }
  }
  if (freshness.stale) {
    const staleError = `${describeStaleness(freshness, filePattern)} ${DAEMON_FIX_HINT}`
    if (jsonMode) {
      printMachineOutput({
        success: false,
        stale: true,
        error: staleError,
        file: filePattern || null,
      })
    } else {
      const label = freshness.missing ? 'Target not found' : 'Test daemon appears STALE'
      console.error(`\n${colors.red}⚠ ${label}${colors.reset} — ${describeStaleness(freshness, filePattern)}`)
      console.error(`${colors.yellow}${DAEMON_FIX_HINT}${colors.reset}\n`)
    }
    process.exitCode = 2
    return
  }

  // Check cache for full test runs (no grep, no file filter, no invert)
  // Cache checks file mtimes, so changed files will invalidate it automatically
  const isFullRun = testNamePatterns.length === 0 && !filePattern && !invert
  const noCache = args.includes('--no-cache')

  if (isFullRun && !noCache) {
    const cached = await checkCache()
    if (cached) {
      const ageSeconds = Math.round(cached.age / 1000)

      if (jsonMode) {
        // Skip cache if it doesn't have JSON data (was populated without --json)
        if (!cached.jsonResult) {
          // Fall through to run tests fresh with JSON reporter
        } else {
          // Return cached JSON result
          // For full runs (cached), grep/file/invert are always null/false
          const output = {
            success: cached.exitCode === 0,
            grep: null,
            file: null,
            invert: false,
            cached: true,
            cached_age_seconds: ageSeconds,
            hint: 'Cached result. File changes are auto-detected - just re-run to get fresh results.',
            ...cached.jsonResult,
          }
          printMachineOutput(output)
          process.exitCode = cached.exitCode
          return
        }
      } else {
        console.log(`\n${colors.cyan}Using cached result (no files changed, ${ageSeconds}s ago)${colors.reset}\n`)
        console.log(cached.output)
        console.log(`${colors.dim}Test run complete: ${cached.failures} failures (cached)${colors.reset}\n`)
        process.exitCode = cached.exitCode
        return
      }
    }
  }

  // Combine patterns with OR regex (defined early for error reporting)
  const grep = testNamePatterns.length > 0
    ? testNamePatterns.map(p => `(${p})`).join('|')
    : ''
  let exitCode = 0
  let outputBuffer = ''
  let failureCount = 0
  let cachePromise = null
  let retrying = false
  let jsonResult = null // Parsed JSON from Mocha reporter
  let startTime = Date.now()
  let jsonProgress = null

  // Check if daemon is running, auto-start if not
  const daemonStatus = await getDaemonStatus()
  if (daemonStatus.status !== 'ready') {
    // Only check for crash diagnostics when daemon is fully down
    if (daemonStatus.status === 'down') {
      const crashDiagnostics = await getServerCrashDiagnostics()
      if (crashDiagnostics) {
        if (await attemptMongoRecovery('startup', crashDiagnostics)) {
          return
        }
        if (jsonMode) {
          const output = {
            success: false,
            error: 'server_crashed',
            message: crashDiagnostics.error,
            stack: crashDiagnostics.stack,
            hint: crashDiagnostics.hint,
            grep: grep || null,
            file: filePattern || null,
            stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
          }
          printMachineOutput(output)
          process.exitCode = 1
          return
        } else {
          console.log(`\n${colors.red}Server crashed:${colors.reset}`)
          console.log(`${colors.red}${crashDiagnostics.error}${colors.reset}`)
          if (crashDiagnostics.stack) {
            console.log(`${colors.dim}${crashDiagnostics.stack.join('\n')}${colors.reset}`)
          }
          console.log(`\n${colors.yellow}${crashDiagnostics.hint}${colors.reset}\n`)
          process.exitCode = 1
          return
        }
      }
    }

    if (!jsonMode) {
      const statusMessage = daemonStatus.status === 'restarting'
        ? 'Daemon restarting, waiting for it to come back...'
        : 'Daemon not running, starting fresh (will load latest code)...'
      console.log(`${colors.yellow}${statusMessage}${colors.reset}\n`)
    }
    const startResult = await startDaemon(jsonMode) // Pass quiet flag for JSON mode

    // Handle startup failure
    if (startResult !== true) {
      const extraMessages = [
        startResult.message,
        ...(startResult.logs || []),
      ].filter(Boolean)
      if (await attemptMongoRecovery('startup', null, extraMessages)) {
        return
      }
      if (jsonMode) {
        const output = {
          success: false,
          error: startResult.error || 'startup_failed',
          message: startResult.message,
          logs: startResult.logs,
          hint: 'Daemon failed to start. Check the error and fix before running tests.',
          grep: grep || null,
          file: filePattern || null,
          stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
        }
        printMachineOutput(output)
      }
      process.exitCode = 1
      return
    }
  }

  // Daemon is confirmed ready here. Gate against the wedged-empty-bundle mode
  // before dispatching: a run against a 0-suite daemon returns a false all-clear.
  const emptiness = await ensureDaemonNotEmpty()
  if (emptiness.empty) {
    reportWedgedEmptyBundle(grep)
    return
  }

  const params = new URLSearchParams()
  if (grep) params.set('grep', grep)
  if (filePattern) params.set('file', filePattern)
  if (invert) params.set('invert', '1')
  if (jsonMode) params.set('reporter', 'json')
  if (snapshotUpdate) params.set('snapshotUpdate', '1')
  if (bail) params.set('bail', '1')

  const url = `http://localhost:${port}/test/run?${params}`

  // Build description
  let desc
  if (filePattern) {
    const filename = path.basename(filePattern)
    desc = testNamePatterns.length > 0
      ? `${filename} (${testNamePatterns.join('|')})`
      : filename
  } else {
    desc = testNamePatterns.length > 0
      ? testNamePatterns.join('|')
      : 'all tests'
  }
  // Only show running message in non-JSON mode
  if (!jsonMode) {
    console.log(`\n🧪 Running tests (${desc})${invert ? ' (inverted)' : ''}...\n`)
  }

  startTime = Date.now()
  jsonProgress = jsonMode
    ? createJsonProgressLogger({ startTime, write: console.error })
    : null
  function reportRestartTimeout(context) {
    const message = context ? `Daemon did not restart (${context})` : 'Daemon did not restart within timeout'
    const recentLogs = getRecentLogs(10)

    if (jsonMode) {
      const output = {
        success: false,
        error: 'restart_timeout',
        message,
        hint: 'Daemon restart timed out. Check daemon logs for the root cause.',
        grep: grep || null,
        file: filePattern || null,
        recent_logs: recentLogs,
        stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
      }
      printMachineOutput(output)
    } else {
      console.log(`\n${colors.red}${message}${colors.reset}`)
      if (recentLogs.length > 0) {
        console.log(`${colors.dim}Recent daemon logs:${colors.reset}`)
        recentLogs.forEach(line => console.log(`  ${colors.dim}${line}${colors.reset}`))
      }
      console.log(`${colors.dim}Check daemon logs with: ./scripts/test-run daemon logs -t${colors.reset}`)
    }
    process.exitCode = 1
  }
  function reportRestartLoop(context) {
    const suffix = context ? ` (${context})` : ''
    const message = `Daemon restarted too frequently${suffix}`
    const recentLogs = getRecentLogs(10)

    if (jsonMode) {
      const output = {
        success: false,
        error: 'restart_loop',
        message,
        hint: 'Daemon keeps restarting. Check daemon logs for OOMs or port conflicts.',
        grep: grep || null,
        file: filePattern || null,
        recent_logs: recentLogs,
        stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
      }
      printMachineOutput(output)
    } else {
      console.log(`\n${colors.red}${message}${colors.reset}`)
      if (recentLogs.length > 0) {
        console.log(`${colors.dim}Recent daemon logs:${colors.reset}`)
        recentLogs.forEach(line => console.log(`  ${colors.dim}${line}${colors.reset}`))
      }
      console.log(`${colors.dim}Check daemon logs with: ./scripts/test-run daemon logs -t${colors.reset}`)
    }
    process.exitCode = 1
  }
  function shouldAbortRestartLoop(context) {
    if (!restartLoopTracker.recordRestart()) return false
    reportRestartLoop(context)
    return true
  }
  async function attemptMongoRecovery(context, crashDiagnostics, extraMessages = []) {
    const recentLogs = getRecentLogs(15)
    if (!hasMongoTimeoutEvidence(crashDiagnostics, recentLogs, extraMessages)) {
      return false
    }

    const message = `Detected MongoDB server monitor timeout${context ? ` (${context})` : ''}; triggering hot reload...`
    if (jsonMode) {
      console.error(`[${Math.round((Date.now() - startTime) / 1000)}s] ${message}`)
    } else {
      console.log(`\n${colors.yellow}⚠ ${message}${colors.reset}`)
    }

    if (shouldAbortRestartLoop('mongo timeout')) {
      return true
    }

    retrying = true
    const hotReload = touchHotReloadFile()
    if (!hotReload.touched) {
      if (!jsonMode) {
        console.log(`${colors.dim}Hot reload touch failed (${hotReload.path}): ${hotReload.error}${colors.reset}`)
        console.log(`${colors.dim}Falling back to full daemon restart...${colors.reset}`)
      }
    } else if (!jsonMode) {
      console.log(`${colors.dim}Touched ${hotReload.path} to trigger reload${colors.reset}`)
    }

    if (hotReload.touched) {
      const restarted = await waitForDaemonRestart({ log: jsonMode ? null : console.log })
      if (restarted) {
        runTests()
        return true
      }
      if (!jsonMode) {
        console.log(`${colors.dim}Hot reload timed out; falling back to full daemon restart...${colors.reset}`)
      }
    }

    await stopDaemon(jsonMode)
    await new Promise(r => setTimeout(r, 1000))

    const startResult = await startDaemon(jsonMode)
    if (startResult === true) {
      runTests()
      return true
    }

    const failureMessage = startResult.message || 'Daemon failed to restart after Mongo timeout'
    const failureLogs = startResult.logs && startResult.logs.length > 0
      ? startResult.logs
      : recentLogs

    if (jsonMode) {
      const output = {
        success: false,
        error: startResult.error || 'mongo_timeout',
        message: failureMessage,
        hint: 'Daemon restart failed after Mongo timeout. Try ./scripts/test-run daemon restart.',
        grep: grep || null,
        file: filePattern || null,
        recent_logs: failureLogs,
        stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
      }
      printMachineOutput(output)
    } else {
      console.log(`\n${colors.red}${failureMessage}${colors.reset}`)
      if (failureLogs.length > 0) {
        console.log(`${colors.dim}Recent daemon logs:${colors.reset}`)
        failureLogs.forEach(line => console.log(`  ${colors.dim}${line}${colors.reset}`))
      }
      console.log(`${colors.dim}Check daemon logs with: ./scripts/test-run daemon logs -t${colors.reset}`)
    }
    process.exitCode = 1
    return true
  }

  function handleEvent(data, setTestsStarted) {
    switch (data.type) {
      case 'start':
        setTestsStarted() // Signal that tests have begun running
        if (!jsonMode) {
          console.log(`${colors.dim}Starting: ${data.grep}${data.invert ? ' (inverted)' : ''}${colors.reset}`)
        } else {
          // Output progress to stderr so stdout remains valid JSON
          console.error(`[${Math.round((Date.now() - startTime) / 1000)}s] Starting tests...`)
        }
        break

      case 'log':
        // Raw console output from Mocha (already has ANSI colors)
        if (!jsonMode) {
          console.log(data.data)
        } else {
          // In JSON mode, output progress to stderr for each test result line
          jsonProgress?.handleLogLine(data.data)
        }
        outputBuffer += data.data + '\n'
        break

      case 'error':
        if (data.data && data.data.includes('already running')) {
          if (!jsonMode) {
            console.log(`${colors.yellow}Tests already running - waiting 5s to retry...${colors.reset}`)
          }
          retrying = true
          setTimeout(() => runTests(), 5000)
          return // Don't continue processing
        }
        if (!jsonMode) {
          console.error(data.data)
        }
        outputBuffer += data.data + '\n'
        break

      case 'daemon-shutdown':
      case 'shutdown': {
        // Daemon is going away (explicit stop, crash, or signal). Bail out
        // cleanly rather than hanging waiting for a restart that may never come.
        // If it's a hot reload, the mid-test inactivity check will see the
        // daemon come back and the user can just re-run.
        const reason = data.reason || 'unknown'
        // Map known reason strings to friendlier UX text. Unknown reasons
        // fall through verbatim so operators can still debug them.
        const friendly = (() => {
          if (reason === 'SIGTERM' || reason === 'SIGINT') return 'daemon was stopped'
          if (reason === 'already-shutting-down') return 'daemon is shutting down'
          if (typeof reason === 'string' && reason.startsWith('uncaughtException')) return 'daemon crashed'
          return reason
        })()
        const message = `Test daemon shut down (${friendly}) — exiting.`
        retrying = true // Suppress the normal end-of-stream exit path
        if (jsonMode) {
          console.error(`[${Math.round((Date.now() - startTime) / 1000)}s] ${message}`)
          const output = {
            success: false,
            error: 'daemon_shutdown',
            message,
            reason,
            grep: grep || null,
            file: filePattern || null,
            stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
          }
          printMachineOutput(output)
        } else {
          console.log(`\n${colors.red}${message}${colors.reset}`)
        }
        process.exit(2)
      }

      case 'json':
        // Mocha JSON reporter output
        jsonResult = parseMochaJsonPayload(data.data)
        break

      case 'done':
        exitCode = data.failures > 0 ? 1 : 0
        failureCount = data.failures

        restartLoopTracker.reset()

        // Post-run confirmation of the wedged-empty-bundle mode: the daemon
        // emits suitesTotal (top-level suites loaded before grep). 0 means the
        // bundle is empty — a false all-clear, NOT a genuine no-match. Catches a
        // wedge that slipped past the pre-run gate (e.g. bundle collapsed mid-run,
        // or the bare full-run path). Older daemons omit suitesTotal → skip.
        const wedgedEmpty = isWedgedEmptyResult(data)
        if (wedgedEmpty) {
          reportWedgedEmptyBundle(grep)
          break
        }

        // Check for no tests matched when a pattern was specified. suitesTotal>0
        // here (or unknown), so tests=0 is a real no-match, not a wedge.
        const hasPattern = grep || filePattern
        const noTestsMatched = shouldReportNoTestsMatched(hasPattern, jsonResult, data)
        if (noTestsMatched) {
          exitCode = 1 // Treat as error - pattern matched nothing
        }

        if (jsonMode) {
          // Output final progress to stderr
          const durationMs = Date.now() - startTime
          const durationSec = Math.round(durationMs / 1000)
          const status = noTestsMatched ? '⚠ NO MATCH' : (data.failures > 0 ? '✗ FAILED' : '✓ PASSED')
          console.error(`[${durationSec}s] ${status} (${data.failures} failures)`)

          // Default stats for consistent output when jsonResult is missing or incomplete
          const defaultStats = { suites: 0, tests: 0, passes: 0, pending: 0, failures: data.failures || 0 }

          // Build final JSON output (stdout)
          const output = {
            success: exitCode === 0,
            ...(noTestsMatched ? {
              error: 'no_tests_matched',
              message: `No tests matched pattern: ${grep || filePattern}`,
              hint: 'Check the pattern - use -t for test names, file paths for specific files.',
            } : {
              hint: 'Fresh run. Results cached for 1 min unless source files change.',
            }),
            grep: grep || null,
            file: filePattern || null,
            invert: invert || false,
            duration_ms: durationMs,
            stats: defaultStats,
            ...(jsonResult || {}),
          }
          printMachineOutput(output)
        } else {
          if (noTestsMatched) {
            console.log(`\n${colors.yellow}⚠ No tests matched pattern: ${grep || filePattern}${colors.reset}`)
            console.log(`${colors.dim}Check the pattern - use -t for test names, file paths for specific files.${colors.reset}\n`)
          } else {
            console.log(`\n${colors.dim}Test run complete: ${data.failures} failures${colors.reset}\n`)
          }
        }

        // Save to cache for full runs (store promise to await later)
        if (isFullRun) {
          cachePromise = saveCache(outputBuffer, exitCode, failureCount, jsonResult)
        }
        break

      case 'heartbeat':
        // Server is alive, tests running - handled by data event resetting lastActivity
        break
    }
  }

  // Make request
  const req = http.get(url, (res) => {
    if (res.statusCode !== 200) {
      console.error(`Error: Server returned ${res.statusCode}`)
      process.exit(1)
    }

    let buffer = ''
    let lastActivity = Date.now()
    let inactivityWarnings = 0
    let testsStarted = false // Track if we've received the 'start' event from Mocha

    // Two-phase timeout:
    // - Before 'start' event: 120s (Mocha is loading/discovering tests after daemon rebuild)
    // - After 'start' event: 15s (Mocha default is 2s per test, so 15s means hung)
    const INITIAL_TIMEOUT_SECONDS = 120 // Wait up to 2 min for tests to start loading
    const HANG_THRESHOLD_SECONDS = 15 // After tests start, 15s silence = hung
    const inactivityCheck = setInterval(async () => {
      const elapsed = Math.round((Date.now() - lastActivity) / 1000)

      // Check if daemon restarted mid-test
      if (elapsed >= 5) {
        const daemonUp = await isDaemonRunning()
        if (!daemonUp) {
          clearInterval(inactivityCheck)
          req.destroy()
          retrying = true
          if (!jsonMode) {
            console.log(`\n${colors.yellow}⚠ Daemon restarted during test run, waiting for it to come back...${colors.reset}`)
          }
          // Wait for daemon to come back up, then retry
          const restarted = await waitForDaemonRestart({ log: jsonMode ? null : console.log })
          if (restarted) {
            if (!shouldAbortRestartLoop('mid-test')) {
              runTests()
            }
          } else {
            reportRestartTimeout('mid-test')
          }
          return
        }
      }

      // Use different thresholds based on whether tests have started
      const threshold = testsStarted ? HANG_THRESHOLD_SECONDS : INITIAL_TIMEOUT_SECONDS

      if (elapsed >= threshold) {
        inactivityWarnings++
        const recentLogs = getRecentLogs(15)

        // Check if server crashed during test run
        const crashDiagnostics = await getServerCrashDiagnostics()
        if (crashDiagnostics) {
          clearInterval(inactivityCheck)
          req.destroy()
          if (await attemptMongoRecovery('during tests', crashDiagnostics)) {
            return
          }
          if (jsonMode) {
          const output = {
            success: false,
            error: 'server_crashed',
            message: crashDiagnostics.error,
            stack: crashDiagnostics.stack,
            hint: crashDiagnostics.hint,
            grep: grep || null,
            file: filePattern || null,
            stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
          }
          printMachineOutput(output)
          process.exitCode = 1
        } else {
            console.log(`\n${colors.red}Server crashed during tests:${colors.reset}`)
            console.log(`${colors.red}${crashDiagnostics.error}${colors.reset}`)
            if (crashDiagnostics.stack) {
              console.log(`${colors.dim}${crashDiagnostics.stack.join('\n')}${colors.reset}`)
            }
            console.log(`\n${colors.yellow}${crashDiagnostics.hint}${colors.reset}\n`)
            process.exitCode = 1
          }
          return
        }

        if (jsonMode) {
          clearInterval(inactivityCheck)
          req.destroy()
          const phase = testsStarted ? 'during tests' : 'before tests started'
          const hint = testsStarted
            ? `No test output for ${elapsed}s (Mocha timeout is 2s). Test is hung.`
            : `Tests did not start within ${elapsed}s. Mocha may be stuck loading.`
          const output = {
            success: false,
            error: 'timeout',
            inactivity_seconds: elapsed,
            tests_started: testsStarted,
            hint,
            grep: grep || null,
            file: filePattern || null,
            recent_logs: recentLogs,
            stats: { suites: 0, tests: 0, passes: 0, pending: 0, failures: 0 },
          }
          printMachineOutput(output)
          process.exitCode = 1
        } else {
          if (testsStarted) {
            console.log(`${colors.yellow}⚠ No output for ${elapsed}s - test may be hung (Mocha timeout is 2s)${colors.reset}`)
          } else {
            console.log(`${colors.yellow}⚠ Tests haven't started yet (${elapsed}s) - Mocha may be stuck loading${colors.reset}`)
          }
          if (inactivityWarnings >= 2) {
            console.log(`${colors.dim}  Tip: Check daemon logs with: ./scripts/test-run daemon logs -t${colors.reset}`)
          }
          // Show recent logs on second warning
          if (inactivityWarnings === 2 && recentLogs.length > 0) {
            console.log(`\n${colors.dim}Recent daemon logs:${colors.reset}`)
            recentLogs.forEach(line => console.log(`  ${colors.dim}${line}${colors.reset}`))
          }
        }
      }
    }, 5000) // Check every 5s

    res.on('data', (chunk) => {
      buffer += chunk
      const lines = buffer.split('\n\n')
      buffer = lines.pop() || '' // Keep incomplete chunk

      for (const line of lines) {
        if (line.startsWith('data: ')) {
          try {
            const data = JSON.parse(line.slice(6))
            // Only reset activity timer on actual test output, not heartbeats
            // This way we detect hung tests even if connection is alive
            if (isActivityEvent(data)) {
              lastActivity = Date.now()
            }
            handleEvent(data, () => { testsStarted = true })
          } catch (e) {
            // Ignore parse errors
          }
        }
      }
    })

    res.on('end', async () => {
      clearInterval(inactivityCheck)

      // If retrying due to "already running", don't exit
      if (retrying) return

      // Wait for cache to be saved before exiting
      if (cachePromise) {
        await cachePromise.catch(() => {}) // Ignore cache errors
      }

      if (watchMode) {
        // Watch mode: wait for daemon restart, then re-run
        console.log(`${colors.cyan}Watching for changes... (Ctrl+C to exit)${colors.reset}`)
        const restarted = await waitForDaemonRestart({ log: jsonMode ? null : console.log })
        if (restarted) {
          if (!shouldAbortRestartLoop('watch mode')) {
            runTests() // Re-run with same parameters
          }
        } else {
          reportRestartTimeout('watch mode')
        }
      } else {
        // Use exitCode instead of exit() to allow stdout to flush when piped
        process.exitCode = exitCode
      }
    })
  })

  req.on('error', async (err) => {
    if (watchMode && err.code === 'ECONNREFUSED') {
      // Daemon went down - wait for it to come back
      console.log(`${colors.yellow}Daemon stopped, waiting for restart...${colors.reset}`)
      const restarted = await waitForDaemonRestart({ log: jsonMode ? null : console.log })
      if (restarted) {
        if (!shouldAbortRestartLoop('watch mode')) {
          runTests()
        }
      } else {
        reportRestartTimeout('watch mode')
      }
    } else {
      console.error(`${colors.red}Error: ${err.message}${colors.reset}`)
      process.exit(1)
    }
  })
}

/**
 * Wait for daemon to restart (go down then come back up)
 */
async function waitForDaemonRestart(options = {}) {
  const timeoutMs = options.timeoutMs ?? RESTART_WAIT_TIMEOUT_MS
  const pollMs = options.pollMs ?? 500
  const isRunning = options.isRunning ?? isDaemonRunning
  const log = Object.prototype.hasOwnProperty.call(options, 'log')
    ? options.log
    : console.log
  const startTime = Date.now()

  // First wait for daemon to go down (if it's still up)
  let wasDown = false
  while (Date.now() - startTime < timeoutMs) {
    const running = await isRunning()
    if (!running) {
      wasDown = true
    } else if (wasDown) {
      // Daemon is back up
      if (typeof log === 'function') {
        log(`\n${colors.green}Daemon restarted!${colors.reset}\n`)
      }
      return true
    }
    await new Promise(r => setTimeout(r, pollMs))
  }

  return false
}

if (require.main === module) {
  main()
}

